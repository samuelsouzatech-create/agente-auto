# Exemplo do .env (só textos de exemplo; o .env de verdade nunca vai para o Git).
# Banco PostgreSQL (docker compose up -d). Troque TROQUE-ESTA-SENHA nas duas linhas.
POSTGRES_SENHA=TROQUE-ESTA-SENHA
BANCO_PORTA=5432
BANCO_URL=postgresql://leo:TROQUE-ESTA-SENHA@127.0.0.1:5432/leo
# Testes: usam um banco separado, criado sozinho, com o mesmo nome terminado em _teste
# (ex.: leo_teste). Para usar outro: BANCO_URL_TESTE=postgresql://...
# Redis (DK1, docker compose): senha obrigatória; porta só em 127.0.0.1.
REDIS_SENHA=TROQUE-ESTA-SENHA
REDIS_PORTA=6379
# Scripts e testes deste computador falam com o Redis do compose:
REDIS_URL=redis://:TROQUE-ESTA-SENHA@127.0.0.1:6379/0
# Docker: "demo" liga o simulador (usa a IA); "telegram" liga o bot (canal real). Separe por vírgula.
COMPOSE_PROFILES=demo
# Só no servidor: domínio real e porteiro aberto para a internet (no computador, deixe sem).
# LEO_DOMINIO=painel.sualoja.com.br
# PORTEIRO_IP=0.0.0.0

# IG1 (Instagram): segredo e token de verificação do app da Meta (nunca o token de envio aqui:
# cada loja tem o seu, numa variável própria, informada no token_ref do canal).
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_API_URL=https://graph.facebook.com
# INSTAGRAM_API_VERSAO=v27.0
# INSTAGRAM_TOKEN_LOJA1=
